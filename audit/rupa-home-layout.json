  "en-1440": {
    "viewport": 1440,
    "height": 1990,
    "scroll": 1440,
    "client": 1440,
    "edges": [
      240,
      1136
    ],
    "blocks": [
      {
        "selector": "H1",
        "text": "Yunar Prawira",
        "width": 960,
        "characters": 13,
        "lines": 1
      },
      {
        "selector": "role",
        "text": "Project manager · HR technology implementation",
        "width": 960,
        "characters": 46,
        "lines": 1
      },
      {
        "selector": "lede",
        "text": "I implement HR systems in large companies. I also build my own AI products and write about what I learn from both.",
        "width": 960,
        "characters": 114,
        "lines": 1
      },
      {
        "selector": "H2",
        "text": "Kilas",
        "width": 960,
        "characters": 5,
        "lines": 1
      },
      {
        "selector": "P",
        "text": "An AI brief published three times a week: models, research, and how AI changes work. Every figure links to its source.",
        "width": 960,
        "characters": 118,
        "lines": 1
      },
      {
        "selector": "text-link",
        "text": "Read Kilas",
        "width": 63,
        "characters": 10,
        "lines": 1
      },
      {
        "selector": "H2",
        "text": "Portfolio",
        "width": 960,
        "characters": 9,
        "lines": 1
      },
      {
        "selector": "P",
        "text": "Enterprise implementation case studies: situations, decisions, results, and lessons I take into the next project.",
        "width": 960,
        "characters": 113,
        "lines": 1
      },
      {
        "selector": "text-link",
        "text": "Open portfolio on Notion",
        "width": 156,
        "characters": 24,
        "lines": 1
      },
      {
        "selector": "H2",
        "text": "Latest editions of Kilas",
        "width": 960,
        "characters": 24,
        "lines": 1
      },
      {
        "selector": "edisi-judul",
        "text": "98 percent pass, a quarter match",
        "width": 309,
        "characters": 32,
        "lines": 1
      },
      {
        "selector": "edisi-ringkas",
        "text": "Anthropic's test suite passes 98%, but only a quarter of production inputs match. On the same day, Nvidia stops shipping servers to Indonesia, and MCP servers can send instructions that nobody reads.",
        "width": 631,
        "characters": 199,
        "lines": 3
      },
      {
        "selector": "meta",
        "text": "27 November 2026",
        "width": 872,
        "characters": 16,
        "lines": 1
      },
      {
        "selector": "edition-number",
        "text": "27",
        "width": 64,
        "characters": 2,
        "lines": 1
      },
      {
        "selector": "edisi-judul",
        "text": "Boundaries that only work when written down",
        "width": 447,
        "characters": 43,
        "lines": 1
      },
      {
        "selector": "edisi-ringkas",
        "text": "Six Claude models try to escape a sandbox in 21-32% of scenarios, but only 0.6-1.6% misuse it. Explicitly written boundaries change behaviour, and this week three companies put those boundaries where they can be read.",
        "width": 631,
        "characters": 217,
        "lines": 3
      },
      {
        "selector": "meta",
        "text": "25 November 2026",
        "width": 872,
        "characters": 16,
        "lines": 1
      },
      {
        "selector": "edition-number",
        "text": "26",
        "width": 64,
        "characters": 2,
        "lines": 1
      },
      {
        "selector": "edisi-judul",
        "text": "Twenty gigabytes, and origins that cannot be seen",
        "width": 478,
        "characters": 49,
        "lines": 1
      },
      {
        "selector": "edisi-ringkas",
        "text": "An Apache-licensed 26B model can run offline on a laptop and outperform a 27B model in a coding agent. On the same day, a US House committee says nobody can be certain whose model is working inside their products.",
        "width": 631,
        "characters": 213,
        "lines": 3
      },
      {
        "selector": "meta",
        "text": "23 November 2026",
        "width": 872,
        "characters": 16,
        "lines": 1
      },
      {
        "selector": "edition-number",
        "text": "25",
        "width": 64,
        "characters": 2,
        "lines": 1
      },
      {
        "selector": "text-link",
        "text": "All editions and topic archives",
        "width": 183,
        "characters": 31,
        "lines": 1
      },
      {
        "selector": "H2",
        "text": "Discuss a project",
        "width": 960,
        "characters": 17,
        "lines": 1
      },
      {
        "selector": "P",
        "text": "For project management, HRIS implementation, or building an AI product together.",
        "width": 960,
        "characters": 80,
        "lines": 1
      },
      {
        "selector": "P",
        "text": "Send a paragraph about the problem, not a tender attachment.",
        "width": 960,
        "characters": 60,
        "lines": 1
      },
      {
        "selector": "text-link mail",
        "text": "mail@yunarprawira.com",
        "width": 240,
        "characters": 21,
        "lines": 1
      }
    ]
  },
