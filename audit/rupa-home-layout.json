        "width": 167,
        "characters": 27,
        "lines": 1
      },
      {
        "selector": "H2",
        "text": "Membicarakan proyek",
        "width": 960,
        "characters": 19,
        "lines": 1
      },
      {
        "selector": "P",
        "text": "Untuk pekerjaan project management, implementasi HRIS, atau membangun produk AI bersama.",
        "width": 960,
        "characters": 88,
        "lines": 1
      },
      {
        "selector": "P",
